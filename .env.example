# Copy to `.env` and fill in. `.env` is git-ignored, so never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_USER=journallm
POSTGRES_PASSWORD=journallm
POSTGRES_DB=journallm
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://journallm:journallm@localhost:5432/journallm

# --- API ---
# When set, every request needs `Authorization: Bearer <API_TOKEN>`.
API_TOKEN=
# Where page images and exports are stored (git-ignored).
DATA_DIR=./data

# --- OpenAI ---
OPENAI_API_KEY=
TRANSCRIBE_MODEL=
CHAT_MODEL=
EMBED_MODEL=text-embedding-3-small
