# Copy to `.env` and fill in. `.env` is git-ignored, so never commit real secrets.

# --- Postgres (docker compose) ---
POSTGRES_USER=kritzellm
POSTGRES_PASSWORD=kritzellm
POSTGRES_DB=kritzellm
POSTGRES_PORT=5432
# For running the backend outside docker (`just backend-dev`). Inside compose, `api` talks to `db` instead.
DATABASE_URL=postgresql+asyncpg://kritzellm:kritzellm@localhost:5432/kritzellm

# --- API ---
API_PORT=8000
# When set, every request (except /health) needs `Authorization: Bearer <API_TOKEN>`.
API_TOKEN=
# Where page images and exports are stored (git-ignored). Inside compose it's the `api-data` volume.
DATA_DIR=./data

# --- OpenAI ---
OPENAI_API_KEY=
TRANSCRIBE_MODEL=gpt-6-luna
CHAT_MODEL=gpt-6-luna
EMBED_MODEL=text-embedding-3-small
