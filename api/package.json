{
  "name": "kritzellm-api-tools",
  "private": true,
  "description": "Tooling for the kritzeLLM OpenAPI contract: lint, mock server, docs preview",
  "type": "module",
  "scripts": {
    "lint": "redocly lint openapi.json",
    "mock": "prism mock --dynamic --json-schema-faker-fillProperties false openapi.json --port 4010",
    "docs": "scalar document serve openapi.json --watch --port 4011"
  },
  "devDependencies": {
    "@redocly/cli": "2.57.0",
    "@scalar/cli": "2.10.0",
    "@stoplight/prism-cli": "5.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "lodash": "4.18.0",
    "uuid": "11.1.1"
  }
}
